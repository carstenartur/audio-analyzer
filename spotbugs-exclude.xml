<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for Audio Analyzer project
  
  Rationale for exclusions:
  - EI_EXPOSE_REP/EI_EXPOSE_REP2: WaveformModel uses defensive copies in getters/constructor
    to ensure immutability. While SpotBugs may flag direct field returns, our implementation
    properly handles this with Arrays.copyOf(), making the warning a false positive.
  - SE_BAD_FIELD: GUI components extending Swing classes may have non-serializable fields.
    This is acceptable as we don't serialize GUI components.
  - MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR: Swing components often call overridable methods
    in constructors (e.g., setLayout, add). This is standard Swing pattern and safe.
  
  TODO: Reevaluate EI_EXPOSE_REP exclusions after performance refactor to ensure
        defensive copying strategy remains appropriate
-->

<FindBugsFilter>
  <!-- Suppress EI_EXPOSE_REP warnings for WaveformModel - defensive copies are used -->
  <Match>
    <Class name="org.hammer.audio.WaveformModel"/>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>
  
  <!-- Suppress EI_EXPOSE_REP2 for service setters in GUI components -->
  <Match>
    <Or>
      <Class name="~.*Frame"/>
      <Class name="~.*Panel"/>
      <Class name="~.*Canvas"/>
    </Or>
    <Method name="setAudioCaptureService"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  
  <!-- Suppress serialization warnings for GUI components and service fields -->
  <Match>
    <Or>
      <Class name="~.*Frame"/>
      <Class name="~.*Panel"/>
      <Class name="~.*Canvas"/>
    </Or>
    <Or>
      <Bug pattern="SE_BAD_FIELD"/>
      <Bug pattern="SE_BAD_FIELD_STORE"/>
    </Or>
  </Match>
  
  <!-- Suppress overridable method call in constructor for Swing components -->
  <Match>
    <Or>
      <Class name="~.*Frame"/>
      <Class name="~.*Panel"/>
      <Class name="~.*Canvas"/>
    </Or>
    <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
  </Match>
  
  <!-- Suppress RV_RETURN_VALUE_IGNORED for GUI setup methods and thread management -->
  <!-- ExecutorService.submit() return value may be intentionally ignored -->
  <Match>
    <Or>
      <Class name="~.*Frame"/>
      <Class name="~.*Panel"/>
      <Class name="org.hammer.audio.AudioCaptureServiceImpl"/>
    </Or>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
  </Match>
  <!-- Legacy per-class bug-pattern suppressions for existing findings -->
  <Match>
    <Class name="org.hammer.AudioAnalyseFrame"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <Match>
    <Class name="org.hammer.AudioAnalyseFrame"/>
    <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
  </Match>
  <Match>
    <Class name="org.hammer.SpectrumPanel"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.WaveformPanel"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.WaveformPanel"/>
    <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.AudioCaptureServiceImpl"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.AudioCaptureServiceImpl"/>
    <Bug pattern="SA_FIELD_SELF_COMPARISON"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.AudioCaptureServiceImpl"/>
    <Bug pattern="VO_VOLATILE_REFERENCE_TO_ARRAY"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.DemoAudioCaptureService"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.DemoAudioCaptureService"/>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.RecordedAudioCaptureService"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.RecordedAudioCaptureService"/>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.analysis.SpectrumDisplayState"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.analysis.SpectrumDisplayState"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.analysis.SpectrumSnapshot"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.analysis.WaveformTrigger$TriggeredView"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.diagnosis.DiagnosisSnapshot"/>
    <Bug pattern="SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR"/>
  </Match>
  <!-- Dataset schema records: Map fields are already immutable (Map.copyOf in compact constructor) -->
  <Match>
    <Class name="org.hammer.audio.experimental.acoustic.dataset.DatasetAnnotation"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.experimental.acoustic.dataset.DatasetDescriptor"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.experimental.acoustic.dataset.DatasetRecording"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.experimental.acoustic.MosquitoLocalizationPipeline"/>
    <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.experimental.acoustic.tracking.SourceTracker$Track"/>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.export.EvidenceBundleExporter"/>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.export.EvidenceData"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.export.EvidenceData$Builder"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.snapshot.PhaseScopeSnapshot"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.spectrogram.SpectrogramAnalyzer"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.spectrogram.SpectrogramAnalyzer"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.spectrogram.SpectrogramFrame"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.ui.theme.PlotRenderTheme"/>
    <Bug pattern="UM_UNNECESSARY_MATH"/>
  </Match>
  <Match>
    <Class name="org.hammer.audio.experimental.acoustic.benchmark.classifier.ConfusionMatrix"/>
    <Method name="asMap"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!-- NM_CONFUSING: DatasetAnalytics.DistributionStats.stddev() vs FeatureStatistics.stdDev()
       differ only in capitalisation; both are intentional API names in separate packages. -->
  <Match>
    <Class name="org.hammer.audio.experimental.acoustic.dataset.DatasetAnalytics$DistributionStats"/>
    <Bug pattern="NM_CONFUSING"/>
  </Match>

</FindBugsFilter>
