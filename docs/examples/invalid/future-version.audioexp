{"$schema":"https://raw.githubusercontent.com/carstenartur/audio-analyzer/master/audio-experiment-document/src/main/resources/schemas/audio-analyzer-experiment-v1.schema.json","format":"io.github.carstenartur.audio-analyzer.experiment","formatVersion":2,"experiment":{"id":"full.example","name":"Portable stereo recording setup","description":"A small synthetic recording with illustrative calibration evidence.","tags":["example","synthetic"],"intent":"analysis","sourceMode":"recording","intendedDuration":"PT1S","applicationVersion":"0.1.0-SNAPSHOT"},"workflow":{"format":"io.github.carstenartur.audio-analyzer.workflow-dsl","formatVersion":1,"content":"workflow\n  id: full-example-workflow\n  name: Recording inspection\n  nodes:\n    - id: inspect\n      type: Waveform\n      label: Inspect samples\n      inputPorts:\n        - id: input\n          name: Input\n          direction: INPUT\n          dataType: AudioBlock\n          required: true\n          multiplicity: SINGLE\n    - id: recording\n      type: Recording\n      label: Portable input\n      outputPorts:\n        - id: audio\n          name: Audio\n          direction: OUTPUT\n          dataType: AudioBlock\n          required: false\n          multiplicity: SINGLE\n  edges:\n    - id: samples\n      sourceNodeId: recording\n      sourcePortId: audio\n      targetNodeId: inspect\n      targetPortId: input\n","sha256":"3b3b163cc5dfe2ef4c5fef53460cd0c5d8b47cb295005ddd18d349094061e478"},"profiles":{"calibration":{"calibratedAt":"2026-01-01T00:00:00Z","channels":[{"channel":0,"driftPpm":0,"gainLinear":1,"invertedPolarity":false,"jitterRmsSamples":0,"offsetSamples":0,"referenceFrame":0,"residualRmsSamples":0},{"channel":1,"driftPpm":0,"gainLinear":1,"invertedPolarity":false,"jitterRmsSamples":0,"offsetSamples":0,"referenceFrame":0,"residualRmsSamples":0}],"evidenceAssetId":"calibration-evidence","id":"synthetic-calibration","referenceChannel":0,"validUntil":"2027-01-01T00:00:00Z"},"capture":{"bigEndian":false,"channels":2,"deviceRequirements":{"description":"Two synchronous input channels; choose a local device explicitly before capture.","synchronizedChannels":true},"sampleRateHz":4.8E+4,"sampleSizeBits":16,"signed":true},"environment":{"notes":"Illustrative indoor assumptions; calibration is synthetic.","relativeHumidityPercent":5E+1,"speedOfSoundMetersPerSecond":343,"temperatureCelsius":2E+1},"microphoneArray":{"id":"stereo-array","microphones":[{"channel":0,"id":"left","xMeters":0,"yMeters":0,"zMeters":0},{"channel":1,"id":"right","xMeters":0.2,"yMeters":0,"zMeters":0}],"name":"Illustrative 20 cm array"},"source":{"assetId":"recording"}},"requiredPlugins":[],"pluginData":{},"assets":[{"id":"calibration-evidence","relativePath":"assets/calibration.json","mediaType":"application/json","sizeBytes":115,"sha256":"fcddcf1bb910224880f7fa4c29c321ee8d6ad074f11ed17cb38b9194572b5191"},{"id":"recording","relativePath":"assets/input.wav","mediaType":"audio/wav","sizeBytes":300,"sha256":"b55afc19a45e89d2b962e359c80ed2f9d4623c73c958e45933b5bbdff19525c2"}],"outputs":[{"id":"report","mediaType":"text/markdown","baseName":"report.md"}],"provenance":{"creatorDisplayName":"Audio Analyzer examples","verifiedAccount":"","createdAt":"2026-07-23T12:00:00Z","modifiedAt":"2026-07-23T12:00:00Z","softwareVersion":"0.1.0-SNAPSHOT","canonicalSha256":"ed68d3fb1e12b8436ef16cce5a026089bdbe210b45cc2ca3bc4b873f1a246bc7","migrationNotes":[],"algorithmVersions":{"waveform":"1"},"sourceCommit":"89f0f8455307ffc8c75619fec3020355f972c3e8","sourceRun":"example-run"}}